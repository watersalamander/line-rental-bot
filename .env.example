# ─────────────────────────────────────────────────────────────
# Copy to .env (dev) and .env.production (prod). NEVER commit real values.
# The server loads .env.${NODE_ENV} first, then falls back to .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# LINE Messaging API channel (Developers Console → Messaging API channel)
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_long_lived_channel_access_token

# Supabase — use a SEPARATE project for dev vs prod (dev/prod isolation)
SUPABASE_URL=https://your-project.supabase.co
# service_role key: server-side only, bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LIFF (Phase 1) — from a LINE Login channel + its LIFF app.
# LINE_LOGIN_CHANNEL_ID verifies LIFF ID tokens; LIFF_ID initialises the web form.
LINE_LOGIN_CHANNEL_ID=your_login_channel_id
LIFF_ID=your_liff_id

# Slip reading (Phase 2)
# 'claude' = Claude Vision (default, pay-per-use, no bank verification)
# 'easyslip' = EasySlip bank verification
SLIP_VENDOR=claude
ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_SLIP_MODEL=claude-haiku-4-5   # override the vision model if needed
# EASYSLIP_TOKEN=your_easyslip_access_token   # only if SLIP_VENDOR=easyslip
